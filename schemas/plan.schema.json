{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-loom.dev/schemas/plan-v1.json",
  "type": "object",
  "required": ["schema_version", "workflow_id", "baseline_id", "tasks", "batches"],
  "properties": {
    "schema_version": {"const": "context-loom/plan-v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1},
    "batches": {"type": "array", "minItems": 1}
  }
}

