{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-loom.dev/schemas/worker-result-v1.json",
  "type": "object",
  "required": ["schema_version", "task_id", "status", "baseline_sha256", "packet_sha256", "content"],
  "properties": {
    "schema_version": {"const": "context-loom/worker-result-v1"},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed"]},
    "baseline_sha256": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "trace": {"type": "object"}
  }
}

