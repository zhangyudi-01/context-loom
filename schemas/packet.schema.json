{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-loom.dev/schemas/packet-v1.json",
  "type": "object",
  "required": ["schema_version", "workflow_id", "batch_id", "mode", "baseline_id", "baseline_sha256", "tasks", "instructions", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "context-loom/packet-v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["simple", "dedicated-fork"]},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_sha256": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1},
    "dynamic_context": {"type": "array", "items": {"type": "object", "required": ["context_id", "path", "sha256", "content"]}},
    "instructions": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "minLength": 1}
  }
}
