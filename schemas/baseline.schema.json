{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-loom.dev/schemas/baseline-v1.json",
  "type": "object",
  "required": ["schema_version", "workflow_id", "baseline_id", "sources", "source_fingerprint", "context"],
  "properties": {
    "schema_version": {"const": "context-loom/baseline-v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "context": {"type": "string"}
  }
}

