{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-loom.dev/schemas/workflow-v1.json",
  "type": "object",
  "required": ["schema_version", "workflow_id", "sources", "tasks"],
  "properties": {
    "schema_version": {"const": "context-loom/workflow-v1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "root": {"type": "string"},
    "sources": {"type": "array", "minItems": 1},
    "tasks": {"type": "array", "minItems": 1}
  }
}

